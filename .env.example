# Concurrency & networking
SCRAPER_CONCURRENCY=5
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
RETRY_DELAY=2000

# Paths
DATABASE_PATH=./data/scraper.db
IMAGES_DIR=./images
LOGS_DIR=./logs

# Image validation (tile logos are often ~230-400 wide and under 250 tall)
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=140
MAX_IMAGE_BYTES=26214400
TMP_ORPHAN_MAX_AGE_MS=3600000

# Matching thresholds
MATCH_ACCEPT_THRESHOLD=100
MATCH_REVIEW_THRESHOLD=70

# Aspect ratio classification (width / height)
PORTRAIT_MIN=0.45
PORTRAIT_MAX=0.85
SQUARE_MIN=0.90
SQUARE_MAX=1.10
LANDSCAPE_MIN=1.30
LANDSCAPE_MAX=2.20

# Optional proxies
HTTP_PROXY=
HTTPS_PROXY=

# Primary source: BC.Game (paginated all_games catalog, no login)
BCGAME_ENABLED=true
BCGAME_CONCURRENCY=8
# ISO country for lobby catalog (Helsinki VPS → FI)
BCGAME_AREA_CODE=FI
# API rejects pageSize < 40
BCGAME_PAGE_SIZE=40
BCGAME_DISTINCT_ID=
BCGAME_CATALOG_CACHE=./data/bcgame-catalog.json
BCGAME_CATALOG_TTL_MS=86400000

# Betgaliano/modulesports catalog (thumbnail artwork only)
BETGALIANO_ENABLED=true
BETGALIANO_CONCURRENCY=8
BETGALIANO_API_URL=https://modulesports.com:55000/api/MyCasino/SearchGames
BETGALIANO_SITE_ID=7
BETGALIANO_PAGE_SIZE=500
BETGALIANO_TAGS=slots,live
BETGALIANO_CATALOG_CACHE=./data/betgaliano-catalog.json
BETGALIANO_CATALOG_TTL_MS=86400000

# Regency Casino live + slots catalogs (square and rectangular artwork)
REGENCYCASINO_ENABLED=true
REGENCYCASINO_CONCURRENCY=8
REGENCYCASINO_API_BASE_URL=https://games-api.netdnstrace1.com/v2/categories
REGENCYCASINO_IMAGE_BASE_URL=https://aws-origin.image-tech-storage.com/gameRes
REGENCYCASINO_APP_NAME=RegencyCasino.gr
REGENCYCASINO_COUNTRY=GR
REGENCYCASINO_LANG=en
REGENCYCASINO_PLATFORM=mobile
REGENCYCASINO_PAGE_SIZE=50
REGENCYCASINO_CATEGORIES=live,slots
REGENCYCASINO_IMAGE_SIZES=500,350,250
REGENCYCASINO_CATALOG_CACHE=./data/regencycasino-catalog.json
REGENCYCASINO_CATALOG_TTL_MS=86400000

# Databetrix demo catalog (direct game-level img field)
DATABETRIX_ENABLED=true
DATABETRIX_CONCURRENCY=8
DATABETRIX_API_URL=https://api.carvalhobet.test.betinovioslots.net/v1/game/games
DATABETRIX_GAME_SOURCE=DATABETRIX
DATABETRIX_PAGE_SIZE=5000
DATABETRIX_IMPORT_MISSING_GAMES=true
DATABETRIX_CATALOG_CACHE=./data/databetrix-catalog.json
DATABETRIX_CATALOG_TTL_MS=86400000

# Grosvenor Casino catalog (centered logo composited over landscape background)
GROSVENORCASINO_ENABLED=true
GROSVENORCASINO_CONCURRENCY=4
GROSVENORCASINO_BASE_URL=https://www.grosvenorcasinos.com
GROSVENORCASINO_CATALOG_URL=https://www.grosvenorcasinos.com/slots-and-games/all?_data=routes%2F%24
GROSVENORCASINO_SEARCH_URL=https://www.grosvenorcasinos.com/actions/gameSearch
GROSVENORCASINO_IMAGE_WIDTH=800
GROSVENORCASINO_CATALOG_CACHE=./data/grosvenorcasino-catalog.json
GROSVENORCASINO_CATALOG_TTL_MS=86400000

# Multiwin slots + live catalogs
MULTIWIN_ENABLED=true
MULTIWIN_CONCURRENCY=8
MULTIWIN_BASE_URL=https://multiwin11.com
MULTIWIN_API_BASE_URL=https://multiwin11.com/api/v2/games/pages/mirror
MULTIWIN_CATALOG_CACHE=./data/multiwin-catalog.json
MULTIWIN_CATALOG_TTL_MS=86400000

# Optional fallbacks (off by default)
SLOTSJUDGE_ENABLED=false
SLOTSJUDGE_CONCURRENCY=4
STAKE_ENABLED=false
