# Concurrency & networking
SCRAPER_CONCURRENCY=5
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
RETRY_DELAY=2000

# Paths
DATABASE_PATH=./data/scraper.db
IMAGES_DIR=./images
LOGS_DIR=./logs

# Image validation
MIN_IMAGE_WIDTH=250
MIN_IMAGE_HEIGHT=250
MAX_IMAGE_BYTES=26214400
TMP_ORPHAN_MAX_AGE_MS=3600000

# Matching thresholds
MATCH_ACCEPT_THRESHOLD=100
MATCH_REVIEW_THRESHOLD=70

# Aspect ratio classification (width / height)
PORTRAIT_MIN=0.45
PORTRAIT_MAX=0.85
SQUARE_MIN=0.90
SQUARE_MAX=1.10
LANDSCAPE_MIN=1.30
LANDSCAPE_MAX=2.20

# Optional proxies
HTTP_PROXY=
HTTPS_PROXY=

# Optional Stake session (Cloudflare / GraphQL)
# x-access-token is only for logged-in account APIs — not needed for casino search.
STAKE_ACCESS_TOKEN=
# cf_clearance from DevTools. Bound to the IP + User-Agent that solved Cloudflare.
STAKE_CF_CLEARANCE=
# Exact User-Agent from that same browser (DevTools → Network → request headers).
STAKE_USER_AGENT=
# Optional extra Cookie header from that browser. Usually not needed for search.
STAKE_COOKIES=
STAKE_BASE_URL=https://stake.com
STAKE_CONCURRENCY=3
# Proxy provider host+port, not stake.com. Example: http://USER:PASS@proxy.provider.com:8080
STAKE_PROXY=
