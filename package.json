{
  "name": "casino-game-image-scraper",
  "version": "1.0.0",
  "description": "Production-ready casino game image scraper with pluggable source adapters",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "import": "tsx src/cli/index.ts import",
    "analyze-source": "tsx src/cli/index.ts analyze-source",
    "scrape": "tsx src/cli/index.ts scrape",
    "retry-failed": "tsx src/cli/index.ts retry-failed",
    "stats": "tsx src/cli/index.ts stats",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/**/*.test.ts",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "p-limit": "^6.2.0",
    "playwright": "^1.50.1",
    "sharp": "^0.33.5",
    "undici": "^7.3.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
